<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (T1.2.14): Xcode/App Store export switches this to production for release builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Home-screen widgets share their snapshot through the App Group (T8.2.02). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(EVERSLOT_APP_GROUP)</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(EVERSLOT_LINK_DOMAIN)</string>
	</array>
</dict>
</plist>
