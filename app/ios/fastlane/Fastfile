# iOS lanes (T9.2.03). Needs APP_STORE_CONNECT_API_KEY_JSON, MATCH_GIT_URL, MATCH_PASSWORD.
default_platform(:ios)

platform :ios do
  desc "Sign with match and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: JSON.parse(ENV["APP_STORE_CONNECT_API_KEY_JSON"])["key_id"],
      issuer_id: JSON.parse(ENV["APP_STORE_CONNECT_API_KEY_JSON"])["issuer_id"],
      key_content: JSON.parse(ENV["APP_STORE_CONNECT_API_KEY_JSON"])["key"]
    )
    setup_ci
    match(type: "appstore", readonly: true, git_url: ENV["MATCH_GIT_URL"], api_key: api_key)
    build_app(workspace: "Runner.xcworkspace", scheme: "Runner", export_method: "app-store")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
