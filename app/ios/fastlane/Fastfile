# iOS lanes (T9.2.03). Run from app/ios: `bundle exec fastlane <lane>`.
# Needs APP_STORE_CONNECT_API_KEY_JSON ({"key_id", "issuer_id", "key"}), MATCH_GIT_URL, MATCH_PASSWORD
# (see docs/guide.md "Release"). Build first: flutter build ipa --release --no-codesign --flavor prod -t lib/main_prod.dart …
default_platform(:ios)

BUNDLE_ID = "app.everslot"

def asc_api_key
  json = JSON.parse(ENV.fetch("APP_STORE_CONNECT_API_KEY_JSON"))
  app_store_connect_api_key(key_id: json["key_id"], issuer_id: json["issuer_id"], key_content: json["key"])
end

platform :ios do
  desc "Create or refresh certificates and profiles in the match repository (run once, locally)"
  lane :certificates do
    api_key = asc_api_key
    match(type: "development", app_identifier: [BUNDLE_ID], git_url: ENV["MATCH_GIT_URL"], api_key: api_key)
    match(type: "appstore", app_identifier: [BUNDLE_ID], git_url: ENV["MATCH_GIT_URL"], api_key: api_key)
  end

  desc "Sign with match and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, app_identifier: [BUNDLE_ID], git_url: ENV["MATCH_GIT_URL"], api_key: api_key)
    profile = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: ENV["sigh_#{BUNDLE_ID}_appstore_team-id"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "prod",
      configuration: "Release-prod",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } },
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true, changelog: ENV["RELEASE_NOTES"])
  end

  desc "Submit the latest TestFlight build for App Review with a phased release"
  lane :release do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID).to_s,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false },
    )
  end

  desc "Upload store listing texts from fastlane/metadata (EN/FR/AR)"
  lane :metadata do
    upload_to_app_store(api_key: asc_api_key, skip_binary_upload: true, skip_screenshots: true, force: true,
                        precheck_include_in_app_purchases: false)
  end
end
