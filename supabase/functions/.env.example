# Copy to supabase/functions/.env (gitignored) for `supabase functions serve` / `supabase start`.
# Every function degrades gracefully when a value is missing.

# Firebase service-account JSON for FCM HTTP v1 (raw JSON or base64). Without it push-dispatch writes
# inbox rows and marks jobs `skipped` (push_not_configured) and sync-nudge answers {"skipped": ...}.
FCM_SERVICE_ACCOUNT=<BASE64_OF_FIREBASE_SERVICE_ACCOUNT_JSON>

# Shared secret sent by pg_cron / pg_net in the x-cron-secret header (same value as Vault `cron_secret`).
CRON_SECRET=<RANDOM_LONG_SECRET>

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the Supabase runtime (hosted and local).
# With the new API keys, also set the secret key on the hosted project:
# SUPABASE_SECRET_KEY=sb_secret_<...>
