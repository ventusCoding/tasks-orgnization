 {
  "name": "RFC 7529 SKIP=BACKWARD is month-day clamping",
  "text": "DTSTART;TZID=Europe/Paris:20260131T090000\nRRULE:RSCALE=GREGORIAN;SKIP=BACKWARD;FREQ=MONTHLY",
  "rule": {"v": 1, "type": "fixed", "freq": "monthly", "interval": 1, "monthDayOverflow": "clamp"},
  "anchor": {"start": "2026-01-31T09:00", "zone": "Europe/Paris"}
 },
 {
  "name": "non-matching DTSTART becomes an rdate and uses one COUNT",
  "text": "DTSTART;TZID=America/New_York:19970902T090000\nRRULE:FREQ=MONTHLY;COUNT=4;BYMONTHDAY=13;BYDAY=FR",
  "rule": {"v": 1, "type": "fixed", "freq": "monthly", "interval": 1, "byWeekday": [{"day": "FR"}], "byMonthDay": [13], "count": 3, "rdates": ["1997-09-02T09:00"]},
  "anchor": {"start": "1997-09-02T09:00", "zone": "America/New_York"},
  "direction": "parse"
 },
 {
  "name": "non-matching anchor is excluded on export",
  "text": "DTSTART;TZID=America/New_York:19970902T090000\nRRULE:FREQ=MONTHLY;COUNT=4;BYMONTHDAY=13;BYDAY=FR\nEXDATE;TZID=America/New_York:19970902T090000",
  "rule": {"v": 1, "type": "fixed", "freq": "monthly", "interval": 1, "byWeekday": [{"day": "FR"}], "byMonthDay": [13], "count": 3},
  "anchor": {"start": "1997-09-02T09:00", "zone": "America/New_York"},
  "direction": "encode"
 },
 {
  "name": "window_start window as a daily hour x minute cross product",
  "text": "DTSTART;TZID=America/New_York:20260921T090000\nRRULE:FREQ=DAILY;BYHOUR=9,10,11,12,13,14,15,16;BYMINUTE=0,20,40",
