  "text": null,
  "rule": {"v": 1, "type": "fixed", "freq": "minutely", "interval": 90, "window": {"start": "08:00", "end": "20:00", "anchor": "window_start"}},
  "anchor": {"start": "2026-09-21T08:00", "zone": "Europe/Paris"},
  "direction": "encode"
 },
 {
  "name": "series_start window cutting an hour is not representable",
  "text": null,
  "rule": {"v": 1, "type": "fixed", "freq": "minutely", "interval": 30, "window": {"start": "08:00", "end": "10:00", "anchor": "series_start"}},
