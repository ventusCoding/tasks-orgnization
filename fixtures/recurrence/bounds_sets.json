[
 {
  "name": "count 10 with 2 exdates yields 8",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 10,
   "exdates": [
    "2026-09-23T08:00",
    "2026-09-27T08:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-24T08:00",
   "2026-09-25T08:00",
   "2026-09-26T08:00",
   "2026-09-28T08:00",
   "2026-09-29T08:00",
   "2026-09-30T08:00"
  ]
 },
 {
  "name": "rdate before the anchor is included",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "weekly",
   "interval": 1,
   "count": 3,
   "rdates": [
    "2026-09-10T15:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-10T15:00",
   "2026-09-21T08:00",
   "2026-09-28T08:00",
   "2026-10-05T08:00"
  ]
 },
 {
  "name": "until exactly equal to an occurrence includes it",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "until": "2026-09-25T08:00"
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00",
   "2026-09-24T08:00",
   "2026-09-25T08:00"
  ]
 },
 {
  "name": "until one minute before an occurrence excludes it",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "until": "2026-09-25T07:59"
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00",
   "2026-09-24T08:00"
  ]
 },
 {
  "name": "date-only exdate removes every time on that day",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "times": [
    "08:00",
    "20:00"
   ],
   "exdates": [
    "2026-09-22"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-21T00:00",
   "to": "2026-09-24T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-21T20:00",
   "2026-09-23T08:00",
   "2026-09-23T20:00"
  ]
 },
 {
  "name": "rdate equal to a generated occurrence is not duplicated",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 3,
   "rdates": [
    "2026-09-22T08:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00"
  ]
 },
 {
  "name": "date-only rdate uses the anchor time",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "weekly",
   "interval": 1,
   "count": 2,
   "rdates": [
    "2026-09-24"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-24T08:00",
   "2026-09-28T08:00"
  ]
 },
 {
  "name": "exdate that matches nothing",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 3,
   "exdates": [
    "2026-09-22T09:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00"
  ]
 },
 {
  "name": "rdate after until is still included",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "until": "2026-09-23T08:00",
   "rdates": [
    "2026-10-01T10:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00",
   "2026-10-01T10:00"
  ]
 },
 {
  "name": "rdates do not consume the count",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 2,
   "rdates": [
    "2026-09-21T12:00",
    "2026-09-30T12:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-21T12:00",
   "2026-09-22T08:00",
   "2026-09-30T12:00"
  ]
 },
 {
  "name": "count exhausted before the range",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 5
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-10-01T00:00",
   "to": "2026-11-01T00:00"
  },
  "expectedKeys": []
 },
 {
  "name": "range entirely before the anchor",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-08-01T00:00",
   "to": "2026-09-01T00:00"
  },
  "expectedKeys": []
 },
 {
  "name": "range straddling the anchor",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-18T00:00",
   "to": "2026-09-24T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00"
  ]
 },
 {
  "name": "until before the range",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "until": "2026-09-24T08:00"
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-10-01T00:00",
   "to": "2026-10-10T00:00"
  },
  "expectedKeys": []
 },
 {
  "name": "exdate removes an rdate with the same key",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "weekly",
   "interval": 1,
   "count": 2,
   "exdates": [
    "2026-09-24T08:00"
   ],
   "rdates": [
    "2026-09-24T08:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-28T08:00"
  ]
 },
 {
  "name": "count with interval 3",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 3,
   "count": 4
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-24T08:00",
   "2026-09-27T08:00",
   "2026-09-30T08:00"
  ]
 },
 {
  "name": "countMode completions does not truncate expansion",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "count": 3,
   "countMode": "completions"
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-21T00:00",
   "to": "2026-09-27T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-22T08:00",
   "2026-09-23T08:00",
   "2026-09-24T08:00",
   "2026-09-25T08:00",
   "2026-09-26T08:00"
  ]
 },
 {
  "name": "duration overlap includes the occurrence started before the range",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "times": [
    "22:00"
   ]
  },
  "anchor": {
   "start": "2026-09-20T22:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-21T00:00",
   "to": "2026-09-22T00:00"
  },
  "durationMinutes": 180,
  "expectedKeys": [
   "2026-09-20T22:00",
   "2026-09-21T22:00"
  ]
 },
 {
  "name": "count across a month with monthly overflow skip",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "monthly",
   "interval": 1,
   "byMonthDay": [
    30
   ],
   "count": 4
  },
  "anchor": {
   "start": "2026-01-30T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-01-01T00:00",
   "to": "2027-01-01T00:00"
  },
  "expectedKeys": [
   "2026-01-30T08:00",
   "2026-03-30T08:00",
   "2026-04-30T08:00",
   "2026-05-30T08:00"
  ]
 },
 {
  "name": "exdates on an all-day series (datetime and date forms)",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "daily",
   "interval": 1,
   "exdates": [
    "2026-09-22",
    "2026-09-24T00:00"
   ]
  },
  "anchor": {
   "start": "2026-09-21T00:00",
   "zone": "Europe/Paris",
   "allDay": true
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-21T00:00",
   "to": "2026-09-27T00:00"
  },
  "expectedKeys": [
   "2026-09-21",
   "2026-09-23",
   "2026-09-25",
   "2026-09-26"
  ]
 },
 {
  "name": "rdate on an all-day series",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "weekly",
   "interval": 1,
   "count": 2,
   "rdates": [
    "2026-09-25"
   ]
  },
  "anchor": {
   "start": "2026-09-21T00:00",
   "zone": "Europe/Paris",
   "allDay": true
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21",
   "2026-09-25",
   "2026-09-28"
  ]
 },
 {
  "name": "until on a weekly series with two weekdays",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "weekly",
   "interval": 1,
   "byWeekday": [
    {
     "day": "MO"
    },
    {
     "day": "FR"
    }
   ],
   "until": "2026-10-09T08:00"
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-09-01T00:00",
   "to": "2026-12-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00",
   "2026-09-25T08:00",
   "2026-09-28T08:00",
   "2026-10-02T08:00",
   "2026-10-05T08:00",
   "2026-10-09T08:00"
  ]
 },
 {
  "name": "count 1",
  "rule": {
   "v": 1,
   "type": "fixed",
   "freq": "yearly",
   "interval": 1,
   "count": 1
  },
  "anchor": {
   "start": "2026-09-21T08:00",
   "zone": "Europe/Paris"
  },
  "evalZone": null,
  "range": {
   "from": "2026-01-01T00:00",
   "to": "2030-01-01T00:00"
  },
  "expectedKeys": [
   "2026-09-21T08:00"
  ]
 }
]
